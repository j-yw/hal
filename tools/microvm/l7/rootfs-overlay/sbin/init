#!/bin/sh
set -eu

export PATH=/usr/bin:/bin:/usr/sbin:/sbin

mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t devtmpfs -o nosuid,noexec devtmpfs /dev
mount -t sysfs -o ro,nosuid,nodev,noexec sysfs /sys
mount -t tmpfs -o mode=0755,nosuid,nodev,noexec,size=16M tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev,noexec,size=64M tmpfs /tmp
mount -t tmpfs -o mode=0700,uid=1000,gid=1000,nosuid,nodev,size=512M tmpfs /workspace

# Removing keep-caps before the UID transition makes that transition clear the
# effective and permitted sets as well as the explicit sets below.
exec /sbin/hal-init \
	--require-l7-network \
	/usr/bin/setpriv \
	--bounding-set=-all \
	--inh-caps=-all \
	--ambient-caps=-all \
	--securebits=-keep_caps,-keep_caps_locked \
	--reuid 1000 \
	--regid 1000 \
	--clear-groups \
	--no-new-privs \
	/usr/bin/hal-guest-agent
