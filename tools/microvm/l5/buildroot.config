BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_1=y
BR2_STATIC_LIBS=y
BR2_REPRODUCIBLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_INIT_NONE=y
BR2_TARGET_GENERIC_GETTY=n
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_ROOTFS_OVERLAY="/src/tools/microvm/l5/rootfs-overlay"
BR2_ROOTFS_USERS_TABLES="/src/tools/microvm/l5/users.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="/src/tools/microvm/l5/post-build.sh"
BR2_PACKAGE_BUSYBOX=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.1.178"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="/src/tools/microvm/l5/linux.config"
BR2_LINUX_KERNEL_VMLINUX=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="hal-rootfs"
BR2_TARGET_ROOTFS_EXT2_SIZE="64M"
BR2_TARGET_ROOTFS_EXT2_INODES=4096
BR2_TARGET_ROOTFS_EXT2_RESBLKS=0
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-U 8f3e62d8-7e65-4fc2-96d4-8f0d15f13051 -b 4096 -I 256 -O extent,dir_index,filetype,has_journal,sparse_super -E hash_seed=7c4d3b19-4aa5-4e78-9e1b-a561b5f9442c,lazy_itable_init=0,lazy_journal_init=0"
BR2_TARGET_ROOTFS_TAR=y
